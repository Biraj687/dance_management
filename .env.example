# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER reuse this placeholder SECRET_KEY in production.
#
# Generate a production key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=replace-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite is the default (storage-lean, free-tier friendly).
# To use Postgres later: DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3
STUDIO_NAME=Dance Studio
STUDIO_LOGO_URL=
CURRENCY_SYMBOL=रु
CURRENCY_DECIMALS=2
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production-only (required when DJANGO_SETTINGS_MODULE=manage_project.settings.prod)
# ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# DEBUG must remain False in production (prod.py forces this).

